#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D temporalGiSampler;
layout(set = 0, binding = 1) uniform sampler2D temporalGiMetaSampler;
layout(set = 0, binding = 2) uniform sampler2D temporalValidationSampler;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D spatialGiImage;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D spatialGiMetaImage;

layout(push_constant) uniform SpatialPush {
    uvec2 extent;
    vec2 invExtent;
    float spatialWeight;
    float lumaPhi;
    float normalPower;
    float depthScale;
} pc;

vec3 safeNormalize(vec3 v) {
    float len2 = dot(v, v);
    if (len2 > 1.0e-8) {
        return v * inversesqrt(len2);
    }
    return vec3(0.0, 1.0, 0.0);
}

vec3 octDecode(vec2 e) {
    vec2 f = (e * 2.0) - 1.0;
    vec3 v = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (v.z < 0.0) {
        vec2 folded = (1.0 - abs(v.yx)) * sign(v.xy);
        v.x = folded.x;
        v.y = folded.y;
    }
    return safeNormalize(v);
}

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.extent.x) || coord.y >= int(pc.extent.y)) {
        return;
    }

    vec2 uv = (vec2(coord) + vec2(0.5)) * pc.invExtent;
    vec4 centerReservoir = texture(temporalGiSampler, uv);
    vec4 centerMeta = texture(temporalGiMetaSampler, uv);
    vec4 centerValidation = texture(temporalValidationSampler, uv);

    vec3 centerNormal = octDecode(centerValidation.xy);
    float centerDepth = centerValidation.z;
    float centerAlbedo = centerValidation.w;
    float centerLuma = luminance(max(centerReservoir.rgb * max(centerReservoir.a, 0.0), vec3(0.0)));

    vec4 accumReservoir = centerReservoir;
    vec4 accumMeta = centerMeta;
    float weightSum = 1.0;

    const ivec2 offsets[4] = ivec2[](
        ivec2(1, 0),
        ivec2(-1, 0),
        ivec2(0, 1),
        ivec2(0, -1)
    );

    float spatialStrength = clamp(pc.spatialWeight, 0.0, 0.35);
    float lumaPhi = max(pc.lumaPhi, 0.05);
    float normalPower = clamp(pc.normalPower, 1.0, 24.0);
    float depthScale = max(pc.depthScale, 1.0);

    for (int i = 0; i < 4; ++i) {
        ivec2 nCoord = coord + offsets[i];
        if (nCoord.x < 0 || nCoord.y < 0 || nCoord.x >= int(pc.extent.x) || nCoord.y >= int(pc.extent.y)) {
            continue;
        }

        vec2 nUv = (vec2(nCoord) + vec2(0.5)) * pc.invExtent;
        vec4 nReservoir = texture(temporalGiSampler, nUv);
        vec4 nMeta = texture(temporalGiMetaSampler, nUv);
        vec4 nValidation = texture(temporalValidationSampler, nUv);

        vec3 nNormal = octDecode(nValidation.xy);
        float nDepth = nValidation.z;
        float nAlbedo = nValidation.w;
        float nLuma = luminance(max(nReservoir.rgb * max(nReservoir.a, 0.0), vec3(0.0)));

        float depthDeltaNorm = abs(nDepth - centerDepth) / max(max(abs(nDepth), abs(centerDepth)), 1.0);
        float wDepth = exp(-depthDeltaNorm * depthScale);
        float wNormal = pow(max(dot(nNormal, centerNormal), 0.0), normalPower);
        float wAlbedo = exp(-abs(nAlbedo - centerAlbedo) * 10.0);
        float wLuma = exp(-abs(nLuma - centerLuma) / lumaPhi);
        float w = spatialStrength * wDepth * wNormal * wAlbedo * wLuma;
        if (w <= 1.0e-5) {
            continue;
        }

        accumReservoir += nReservoir * w;
        accumMeta += nMeta * w;
        weightSum += w;
    }

    vec4 outReservoir = accumReservoir / max(weightSum, 1.0e-4);
    vec4 outMeta = accumMeta / max(weightSum, 1.0e-4);
    outReservoir.a = clamp(outReservoir.a, 0.0, 4.0);
    outMeta.x = clamp(outMeta.x, 1.0, 8.0);
    outMeta.w = clamp(outMeta.w, 1.0e-4, 1.0);

    imageStore(spatialGiImage, coord, outReservoir);
    imageStore(spatialGiMetaImage, coord, outMeta);
}
