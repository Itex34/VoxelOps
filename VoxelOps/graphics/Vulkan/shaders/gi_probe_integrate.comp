#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ProbeSample {
    vec4 irradianceDepthMean;
    vec4 depthMomentFrames;
};

layout(set = 0, binding = 0, std430) readonly buffer OccupancyWords {
    uint words[];
} occupancy;

layout(set = 0, binding = 1, std430) readonly buffer MaterialIds {
    uint ids[];
} materialData;

layout(set = 0, binding = 2, std430) buffer ProbeSamples {
    ProbeSample probes[];
} probeData;

layout(set = 0, binding = 3, std430) buffer ProbeStats {
    uint lumaSumFixed;
    uint lumaCount;
    uint _pad0;
    uint _pad1;
} stats;

layout(push_constant) uniform GiPushConstants {
    uint firstProbe;
    uint probesUpdated;
    uint totalProbes;
    uint raysPerProbe;

    int snappedOriginX;
    int snappedOriginY;
    int snappedOriginZ;
    uint spacingBlocks;

    uint probeCountX;
    uint probeCountY;
    uint probeCountZ;
    uint frameIndexLow;

    int occupancyMinX;
    int occupancyMinY;
    int occupancyMinZ;
    uint occupancyDimX;
    uint occupancyDimY;
    uint occupancyDimZ;
    uint occupancyWordCount;

    int worldMinX;
    int worldMaxX;
    int worldMinY;
    int worldMaxY;
    int worldMinZ;
    int worldMaxZ;

    float maxTraceDistance;
    float temporalBlend;
    float sunDirX;
    float sunDirY;
    float sunDirZ;
    float sunIntensity;
} pc;

const float kPi = 3.14159265358979323846;
const float kGoldenRatio = 1.61803398874989484820;

struct TraceResult {
    bool hit;
    float distance;
    ivec3 hitVoxel;
    vec3 hitNormal;
};

vec2 octEncode(vec3 n) {
    vec3 v = n / (abs(n.x) + abs(n.y) + abs(n.z) + 1.0e-6);
    if (v.z < 0.0) {
        vec2 folded = (1.0 - abs(v.yx)) * sign(v.xy);
        v.x = folded.x;
        v.y = folded.y;
    }
    return (v.xy * 0.5) + 0.5;
}

vec3 octDecode(vec2 e) {
    vec2 f = (e * 2.0) - 1.0;
    vec3 v = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (v.z < 0.0) {
        vec2 folded = (1.0 - abs(v.yx)) * sign(v.xy);
        v.x = folded.x;
        v.y = folded.y;
    }
    return normalize(v);
}

bool sampleSolid(ivec3 voxel) {
    if (voxel.y < pc.worldMinY) {
        return true;
    }
    if (voxel.y > pc.worldMaxY) {
        return false;
    }
    if (voxel.x < pc.worldMinX || voxel.x > pc.worldMaxX ||
        voxel.z < pc.worldMinZ || voxel.z > pc.worldMaxZ) {
        return false;
    }

    ivec3 local = voxel - ivec3(pc.occupancyMinX, pc.occupancyMinY, pc.occupancyMinZ);
    if (any(lessThan(local, ivec3(0))) ||
        local.x >= int(pc.occupancyDimX) ||
        local.y >= int(pc.occupancyDimY) ||
        local.z >= int(pc.occupancyDimZ)) {
        return false;
    }

    uint linear = uint(local.x) +
        pc.occupancyDimX * (uint(local.y) + (pc.occupancyDimY * uint(local.z)));
    uint wordIndex = linear >> 5u;
    if (wordIndex >= pc.occupancyWordCount) {
        return false;
    }
    uint mask = 1u << (linear & 31u);
    return (occupancy.words[wordIndex] & mask) != 0u;
}

uint sampleMaterialId(ivec3 voxel) {
    ivec3 local = voxel - ivec3(pc.occupancyMinX, pc.occupancyMinY, pc.occupancyMinZ);
    if (any(lessThan(local, ivec3(0))) ||
        local.x >= int(pc.occupancyDimX) ||
        local.y >= int(pc.occupancyDimY) ||
        local.z >= int(pc.occupancyDimZ)) {
        return 0u;
    }

    uint linear = uint(local.x) +
        pc.occupancyDimX * (uint(local.y) + (pc.occupancyDimY * uint(local.z)));
    return materialData.ids[linear];
}

vec3 relocateProbe(vec3 probePosition) {
    if (!sampleSolid(ivec3(floor(probePosition)))) {
        return probePosition;
    }

    for (int i = 0; i < 4; ++i) {
        probePosition.y += 1.0;
        if (!sampleSolid(ivec3(floor(probePosition)))) {
            return probePosition;
        }
    }

    for (int i = 0; i < 8; ++i) {
        probePosition.y -= 1.0;
        if (!sampleSolid(ivec3(floor(probePosition)))) {
            return probePosition;
        }
    }

    return probePosition;
}

vec3 fibonacciDirection(uint index, uint count) {
    uint c = max(1u, count);
    float invCount = 1.0 / float(c);
    float i = float(index) + 0.5;
    float y = 1.0 - (2.0 * i * invCount);
    float r = sqrt(max(0.0, 1.0 - (y * y)));
    float theta = (2.0 * kPi * i) * (1.0 / kGoldenRatio);
    return normalize(vec3(cos(theta) * r, y, sin(theta) * r));
}

vec3 skyRadiance(vec3 direction) {
    vec3 dir = normalize(direction);
    float up = clamp((dir.y * 0.5) + 0.5, 0.0, 1.0);
    vec3 horizon = vec3(0.22, 0.28, 0.34);
    vec3 zenith = vec3(0.52, 0.62, 0.82);
    vec3 sunDir = normalize(vec3(pc.sunDirX, pc.sunDirY, pc.sunDirZ));
    float sunLobe = pow(clamp(dot(dir, sunDir), 0.0, 1.0), 64.0);
    vec3 base = mix(horizon, zenith, up);
    return base + vec3(1.0, 0.92, 0.76) * (0.25 * pc.sunIntensity * sunLobe);
}

vec3 materialAlbedo(uint materialId) {
    switch (materialId) {
    case 1u: return vec3(0.34, 0.56, 0.26); // Grass
    case 2u: return vec3(0.45, 0.33, 0.22); // Dirt
    case 3u: return vec3(0.54, 0.54, 0.57); // Stone
    case 4u: return vec3(0.20, 0.20, 0.22); // Bedrock
    case 5u: return vec3(0.78, 0.72, 0.55); // Sand
    case 6u: return vec3(0.46, 0.34, 0.21); // Log
    case 7u: return vec3(0.62, 0.62, 0.64); // StoneBrick
    case 8u: return vec3(0.72, 0.67, 0.58); // TempleBrick
    case 9u: return vec3(0.55, 0.41, 0.27); // Wood
    case 10u: return vec3(0.26, 0.46, 0.24); // Leaves
    case 11u: return vec3(0.56, 0.50, 0.43); // IronOre
    case 12u: return vec3(0.72, 0.72, 0.74); // IronBlock
    case 13u: return vec3(0.30, 0.58, 0.38); // EmeraldOre
    case 14u: return vec3(0.70, 0.22, 0.22); // RedBerry
    case 15u: return vec3(0.78, 0.44, 0.20); // OrangeBerry
    case 16u: return vec3(0.26, 0.56, 0.78); // SapphireGem
    case 17u: return vec3(0.66, 0.24, 0.26); // RubyGem
    case 18u: return vec3(0.58, 0.44, 0.30); // CraftingTable
    case 19u: return vec3(0.35, 0.35, 0.35); // Bomb
    case 20u: return vec3(0.32, 0.62, 0.29); // Cactus
    case 21u: return vec3(0.52, 0.16, 0.18); // RubyBlock
    case 22u: return vec3(0.22, 0.42, 0.62); // SapphireBlock
    default: return vec3(0.50);
    }
}

vec3 materialEmission(uint materialId) {
    switch (materialId) {
    case 14u: return vec3(2.80, 0.25, 0.25); // RedBerry
    case 15u: return vec3(2.30, 1.15, 0.22); // OrangeBerry
    case 16u: return vec3(0.22, 0.95, 2.40); // SapphireGem
    case 17u: return vec3(2.20, 0.30, 0.45); // RubyGem
    case 21u: return vec3(1.20, 0.10, 0.16); // RubyBlock
    case 22u: return vec3(0.10, 0.38, 1.25); // SapphireBlock
    default: return vec3(0.0);
    }
}

vec3 shadeHitBounce(TraceResult hit, vec3 rayDirection) {
    vec3 normal = normalize(hit.hitNormal);
    vec3 sunDir = normalize(vec3(pc.sunDirX, pc.sunDirY, pc.sunDirZ));
    uint materialId = sampleMaterialId(hit.hitVoxel);
    vec3 albedo = materialAlbedo(materialId);
    vec3 emission = materialEmission(materialId);

    float ndl = max(dot(normal, sunDir), 0.0);
    float skyWeight = clamp(normal.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 skyIncident = mix(vec3(0.11, 0.12, 0.14), skyRadiance(normal), skyWeight);
    vec3 sunIncident = vec3(1.0, 0.92, 0.76) * (ndl * pc.sunIntensity);
    vec3 ambientIncident = vec3(0.05, 0.05, 0.055);
    vec3 incident = (skyIncident * 0.85) + sunIncident + ambientIncident;

    float viewCos = clamp(dot(normal, -normalize(rayDirection)), 0.0, 1.0);
    float lambertScale = mix(0.85, 1.15, viewCos);
    return (albedo * incident * (0.72 * lambertScale)) + emission;
}

TraceResult traceVoxelDda(vec3 origin, vec3 direction, float maxDistance) {
    TraceResult outResult;
    outResult.hit = false;
    outResult.distance = maxDistance;
    outResult.hitVoxel = ivec3(0);
    outResult.hitNormal = vec3(0.0, 1.0, 0.0);

    if (maxDistance <= 0.0) {
        outResult.distance = 0.0;
        return outResult;
    }

    float dirLen = length(direction);
    if (dirLen <= 1.0e-6) {
        outResult.distance = 0.0;
        return outResult;
    }
    vec3 dir = direction / dirLen;

    ivec3 voxel = ivec3(floor(origin));
    if (sampleSolid(voxel)) {
        outResult.hit = true;
        outResult.distance = 0.0;
        outResult.hitVoxel = voxel;
        outResult.hitNormal = -dir;
        return outResult;
    }

    ivec3 step = ivec3(0);
    vec3 tMax = vec3(1.0e30);
    vec3 tDelta = vec3(1.0e30);

    for (int axis = 0; axis < 3; ++axis) {
        float comp = dir[axis];
        if (abs(comp) < 1.0e-8) {
            continue;
        }

        if (comp > 0.0) {
            step[axis] = 1;
            float nextBoundary = float(voxel[axis] + 1);
            tMax[axis] = (nextBoundary - origin[axis]) / comp;
        } else {
            step[axis] = -1;
            float nextBoundary = float(voxel[axis]);
            tMax[axis] = (nextBoundary - origin[axis]) / comp;
        }
        tDelta[axis] = abs(1.0 / comp);
    }

    float traveled = 0.0;
    for (int i = 0; i < 2048 && traveled <= maxDistance; ++i) {
        int axis = 0;
        if (tMax.y < tMax.x) {
            axis = 1;
        }
        if (tMax.z < tMax[axis]) {
            axis = 2;
        }

        traveled = tMax[axis];
        tMax[axis] += tDelta[axis];
        voxel[axis] += step[axis];

        if (sampleSolid(voxel)) {
            outResult.hit = true;
            outResult.distance = min(traveled, maxDistance);
            outResult.hitVoxel = voxel;
            outResult.hitNormal = vec3(0.0);
            outResult.hitNormal[axis] = float(-step[axis]);
            return outResult;
        }
    }

    outResult.hit = false;
    outResult.distance = maxDistance;
    return outResult;
}

void main() {
    uint updateIndex = gl_GlobalInvocationID.x;
    if (updateIndex >= pc.probesUpdated || pc.totalProbes == 0u || pc.raysPerProbe == 0u) {
        return;
    }

    uint probeLinear = (pc.firstProbe + updateIndex) % pc.totalProbes;
    uint xy = pc.probeCountX * pc.probeCountY;
    uint probeX = probeLinear % pc.probeCountX;
    uint probeY = (probeLinear / pc.probeCountX) % pc.probeCountY;
    uint probeZ = (xy > 0u) ? (probeLinear / xy) : 0u;

    vec3 probePosition =
        vec3(pc.snappedOriginX, pc.snappedOriginY, pc.snappedOriginZ) +
        vec3(probeX, probeY, probeZ) * float(pc.spacingBlocks) +
        vec3(float(pc.spacingBlocks) * 0.5);
    probePosition = relocateProbe(probePosition);

    vec3 irradianceAccum = vec3(0.0);
    float depthMeanAccum = 0.0;
    vec3 dominantDirAccum = vec3(0.0);
    float dominantWeightAccum = 0.0;

    for (uint rayIndex = 0u; rayIndex < pc.raysPerProbe; ++rayIndex) {
        uint rotatedRayIndex =
            (rayIndex + (probeLinear * 17u) + (pc.frameIndexLow * 13u)) % pc.raysPerProbe;
        vec3 direction = fibonacciDirection(rotatedRayIndex, pc.raysPerProbe);
        TraceResult hit = traceVoxelDda(probePosition, direction, pc.maxTraceDistance);

        float depthNorm = clamp(hit.distance / pc.maxTraceDistance, 0.0, 1.0);
        depthMeanAccum += depthNorm;

        vec3 radiance = skyRadiance(direction);
        if (hit.hit) {
            vec3 bounce = shadeHitBounce(hit, direction);
            radiance = mix(skyRadiance(direction) * 0.08, bounce, 0.92);
        }
        irradianceAccum += radiance;
        float rayWeight = max(dot(radiance, vec3(0.2126, 0.7152, 0.0722)), 1.0e-4);
        dominantDirAccum += direction * rayWeight;
        dominantWeightAccum += rayWeight;
    }

    float invRays = 1.0 / float(pc.raysPerProbe);
    vec3 sampledIrradiance = irradianceAccum * invRays;
    float sampledDepthMean = depthMeanAccum * invRays;
    vec3 sampledDominantDir = vec3(0.0, 1.0, 0.0);
    float sampledDirectionality = 0.0;
    if (dominantWeightAccum > 1.0e-5) {
        float dirLen = length(dominantDirAccum);
        if (dirLen > 1.0e-5) {
            sampledDominantDir = dominantDirAccum / dirLen;
            sampledDirectionality = clamp(dirLen / dominantWeightAccum, 0.0, 1.0);
        }
    }
    vec2 sampledDominantDirOct = octEncode(sampledDominantDir);

    ProbeSample probeValue = probeData.probes[probeLinear];
    float integratedFrames = probeValue.depthMomentFrames.y;
    if (integratedFrames < 0.5) {
        probeValue.irradianceDepthMean = vec4(sampledIrradiance, sampledDepthMean);
        probeValue.depthMomentFrames = vec4(sampledDirectionality, 1.0, sampledDominantDirOct);
    } else {
        probeValue.irradianceDepthMean.rgb =
            mix(probeValue.irradianceDepthMean.rgb, sampledIrradiance, pc.temporalBlend);
        probeValue.irradianceDepthMean.a =
            mix(probeValue.irradianceDepthMean.a, sampledDepthMean, pc.temporalBlend);
        probeValue.depthMomentFrames.x =
            mix(probeValue.depthMomentFrames.x, sampledDirectionality, pc.temporalBlend);
        vec3 prevDir = octDecode(probeValue.depthMomentFrames.zw);
        vec3 blendedRawDir = mix(prevDir, sampledDominantDir, pc.temporalBlend);
        vec3 blendedDir = (length(blendedRawDir) > 1.0e-5) ? normalize(blendedRawDir) : vec3(0.0, 1.0, 0.0);
        probeValue.depthMomentFrames.zw = octEncode(blendedDir);
        probeValue.depthMomentFrames.y = min(integratedFrames + 1.0, 65535.0);
    }

    probeData.probes[probeLinear] = probeValue;

    float luma = dot(probeValue.irradianceDepthMean.rgb, vec3(0.2126, 0.7152, 0.0722));
    uint lumaFixed = uint(clamp(luma, 0.0, 64.0) * 100000.0 + 0.5);
    atomicAdd(stats.lumaSumFixed, lumaFixed);
    atomicAdd(stats.lumaCount, 1u);
}
