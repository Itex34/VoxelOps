<rml>
<head>
<style>
	* {
	font-family: "SF Pro Text";
	font-size: 14px;
	color: #d7d7d7;
	box-sizing: border-box;
	}

	body {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	margin: 0;
	pointer-events: none;
	}

	/* Top Left Ping */

	#ping {
	position: absolute;
	left: 24px;
	top: 24px;

	background-color: #1c1c1c;
	border: 1px #4a4a4a;
	border-radius: 6px;

	padding: 6px 6px;
	font-size: 12px;
	color: #d7d7d7;
	}

	/* Killfeed */

	#killfeed {
	position: absolute;
	right: 24px;
	top: 24px;

	width: 420px;

	text-align: right;
	color: #d7d7d7;
	}

	/* Scoreboard */

	#scoreboard {
	position: absolute;
	left: 50%;
	top: 72px;

	width: 600px;

	transform: translate(-50%, 0);

	background-color: #1c1c1cee;
	border: 1px #4a4a4a;
	border-radius: 16px;

	padding: 18px;

	display: none;
	}

	#score_header {
	position: relative;
	margin-bottom: 14px;
	height: 30px;
	}

	#score_title {
	position: absolute;
	left: 0;
	top: 0;

	font-size: 24px;
	font-weight: bold;
	color: #ffffff;
	}

	#score_timer {
	position: absolute;
	right: 0;
	top: 6px;

	font-size: 14px;
	color: #c0c0c0;
	}

	#score_table {
	width: 100%;
	}

	.score_row {
	display: block;
	height: 24px;
	}

	.score_head {
	color: #ffffff;
	font-weight: bold;
	margin-bottom: 4px;
	}

	.col {
	display: inline-block;
	vertical-align: top;

	font-size: 14px;
	color: #d7d7d7;
	}

	.player {
	width: 360px;
	text-align: left;
	}

	.small {
	width: 45px;
	text-align: center;
	}

	.ping_col {
	width: 70px;
	text-align: center;
	}

	.name {
	color: #ffcc7a;
	font-weight: bold;
	}

	/* Player HUD */

	#playerhud {
	position: absolute;
	left: 24px;
	bottom: 110px;

	width: 280px;
	}

	/* HP Label */

	#health_label {
	margin-bottom: 8px;
	font-size: 16px;
	font-weight: bold;
	color: #ffffff;
	}

	/* HP Bar */

	#health_bar_bg {
	width: 260px;
	height: 22px;

	background-color: #242424;
	border: 1px #4a4a4a;
	border-radius: 999px;

	overflow: hidden;
	}

	#health_fill {
	height: 100%;
	width: 0%;
	background-color: #ff9f43;

	border-radius: 999px;
	}

	/* Hotbar */

	#hotbar_row {
	position: absolute;
	left: 50%;
	bottom: 24px;

	transform: translate(-50%, 0);

	white-space: nowrap;
	}

	/* Hotbar Slots */

	.hotbar_slot {
	display: inline-block;
	vertical-align: middle;

	position: relative;

	width: 96px;
	height: 64px;

	margin-right: 10px;

	background-color: #242424;
	border: 1px #4a4a4a;
	border-radius: 12px;

	overflow: hidden;
	}

	.hotbar_slot:last-child {
	margin-right: 0;
	}

	.hotbar_slot.active {
	border: 2px #ff9f43;
	}

	/* Slot Index */

	.hotbar_index {
	position: absolute;
	left: 8px;
	top: 6px;

	color: #a0a0a0;
	font-size: 12px;
	}

	/* Item Name */

	.hotbar_name {
	position: absolute;

	left: 10px;
	right: 10px;
	top: 24px;

	color: #ffffff;
	font-size: 13px;

	white-space: nowrap;
	overflow: hidden;
	}

	/* Quantity */

	.hotbar_qty {
	position: absolute;
	right: 8px;
	bottom: 6px;

	color: #d7d7d7;
	font-size: 12px;
	}

	/* Death Overlay */

	#death_overlay {
	position: absolute;
	left: 0;
	top: 0;

	width: 100%;
	height: 100%;

	display: none;

	background-color: #141414cc;
	}

	/* Death Box */

	#death_box {
	position: absolute;
	left: 50%;
	top: 50%;

	transform: translate(-50%, -50%);

	background-color: #1c1c1c;
	border: 1px #4a4a4a;
	border-radius: 16px;

	padding: 22px 30px;

	min-width: 280px;
	}

	#death_title {
	color: #ffb866;
	font-size: 28px;
	font-weight: bold;

	margin-bottom: 10px;

	text-align: center;
	}

	#death_timer {
	text-align: center;
	color: #d7d7d7;
	font-size: 15px;
	}

	/* Crosshair */

	#crosshair {
	position: absolute;
	left: 50%;
	top: 50%;

	transform: translate(-50%, -50%);

	font-size: 30px;
	font-weight: bold;

	color: #ffffff;
	}
</style>
</head>

<body>

  <div id="ping">Ping: --</div>

  <div id="killfeed"></div>

	<div id="scoreboard">
		<div id="score_header">
			<div id="score_title">Deathmatch</div>
			<div id="score_timer">Time Left: 06:41</div>
		</div>

		<div id="score_table">
			<div class="score_row score_head">
				<div class="col player">Player</div>
				<div class="col small">K</div>
				<div class="col small">D</div>
				<div class="col ping_col">Ping</div>
			</div>
			<div id="score_rows"></div>
		</div>
	</div>

  <div id="playerhud">
    <div id="health_label">HP 100</div>

    <div id="health_bar_bg">
      <div id="health_fill"></div>
    </div>
  </div>

  <div id="hotbar_row">
    <div id="hotbar_slot_0" class="hotbar_slot"></div>
    <div id="hotbar_slot_1" class="hotbar_slot"></div>
    <div id="hotbar_slot_2" class="hotbar_slot"></div>
    <div id="hotbar_slot_3" class="hotbar_slot"></div>
    <div id="hotbar_slot_4" class="hotbar_slot"></div>
    <div id="hotbar_slot_5" class="hotbar_slot"></div>
  </div>

  <div id="death_overlay">
    <div id="death_box">
      <div id="death_title"></div>
      <div id="death_timer"></div>
    </div>
  </div>

  <div id="crosshair">+</div>

</body>
</rml>
