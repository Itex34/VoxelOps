<rml>
	<head>
		<style>
			* {
			font-family: "SF Pro Text";
			font-size: 14px;
			color: #d7d7d7;
			box-sizing: border-box;
			}

			body {
			position: absolute;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
			margin: 0;
			}

			#inventory_backdrop {
			position: absolute;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
			background-color: #141414cc;
			}

			#inventory_panel {
			position: absolute;
			left: 50%;
			top: 50%;
			width: 860px;
			transform: translate(-50%, -50%);

			background-color: #1c1c1c;
			border: 1px #4a4a4a;
			border-radius: 18px;
			padding: 24px;
			}

			#header {
			margin-bottom: 22px;
			}

			#title {
			font-size: 28px;
			font-weight: bold;
			color: #ffffff;
			}

			#status_line {
			margin-top: 4px;
			color: #a0a0a0;
			}

			.section {
			margin-bottom: 20px;
			}

			.section_title {
			font-size: 13px;
			font-weight: bold;
			text-transform: uppercase;
			letter-spacing: 1px;
			margin-bottom: 10px;
			color: #d7d7d7;
			}

			.grid {
			display: flex;
			flex-wrap: wrap;
			}

			.slot_btn {
			position: relative;

			width: 122px;
			height: 68px;
			margin-right: 10px;
			margin-bottom: 10px;

			text-align: left;
			padding: 10px;

			background-color: #242424;
			border: 1px #4a4a4a;
			border-radius: 11px;
			}

			.slot_btn:hover {
			background-color: #242424;
			border: 1px #ff9f43;
			}

			.slot_btn:active {
			background-color: #242424;
			border: 1px #ff7b00;
			}

			.slot_btn.empty {
			background-color: #1c1c1c;
			border: 1px #4a4a4a;
			}

			.slot_btn.filled {
			background-color: #242424;
			border: 1px #4a4a4a;
			}

			.slot_btn.ammo {
			background-color: #242424;
			border: 1px #ffb866;
			}

			.slot_btn.hotbar {
			background-color: #242424;
			border: 1px #ff9f43;
			}

			.slot_btn.selected {
			background-color: #242424;
			border: 2px #ff7b00;
			}

			.slot_index {
			font-size: 11px;
			color: #a0a0a0;
			margin-bottom: 5px;
			}

			.slot_item {
			font-size: 14px;
			font-weight: bold;
			color: #ffffff;
			}

			.slot_count {
			position: absolute;
			left: 10px;
			bottom: 8px;

			font-size: 13px;
			font-weight: bold;
			color: #d7d7d7;
			}

			.empty .slot_item {
			color: #a0a0a0;
			font-weight: normal;
			}

			#bottom_area {
			display: flex;
			margin-top: 8px;
			}

			#selected_panel {
			width: 420px;
			min-height: 76px;

			background-color: #242424;
			border: 1px #4a4a4a;
			border-radius: 12px;

			padding: 14px;
			margin-right: 14px;
			}

			#selected_label {
			font-size: 12px;
			font-weight: bold;
			text-transform: uppercase;
			letter-spacing: 1px;
			color: #a0a0a0;
			margin-bottom: 8px;
			}

			#selected_line {
			font-size: 15px;
			font-weight: bold;
			color: #ffffff;
			}

			#actions {
			display: flex;
			align-items: flex-end;
			}

			.action_btn {
			width: 118px;
			height: 42px;
			margin-right: 8px;

			background-color: #ff9f43;
			border: 0;
			border-radius: 10px;

			color: #141414;
			font-weight: bold;
			}

			.action_btn:hover {
			background-color: #ffb866;
			}

			.action_btn:active {
			background-color: #ff7b00;
			}

			#drop1_btn {
			background-color: #242424;
			border: 1px #4a4a4a;
			color: #ffffff;
			}

			#drop1_btn:hover {
			background-color: #1c1c1c;
			border: 1px #ff9f43;
			}

			#dropstack_btn {
			background-color: #ff7b00;
			color: #141414;
			}

			#dropstack_btn:hover {
			background-color: #ff9f43;
			}
		</style>
	</head>

	<body>
		<div id="inventory_backdrop">
			<div id="inventory_panel">

				<div id="header">
					<div id="title">Inventory</div>
					<div id="status_line">Manage weapons, ammo, resources, and equipment.</div>
				</div>

				<div class="section">
					<div class="section_title">Ammo</div>
					<div id="ammo_grid" class="grid"></div>
				</div>

				<div class="section">
					<div class="section_title">Backpack</div>
					<div id="bag_grid" class="grid"></div>
				</div>

				<div class="section">
					<div class="section_title">Hotbar</div>
					<div id="hotbar_grid" class="grid"></div>
				</div>

				<div id="bottom_area">
					<div id="selected_panel">
						<div id="selected_label">Selected Item</div>
						<div id="selected_line">No slot selected.</div>
					</div>

					<div id="actions">
						<button id="use_btn" class="action_btn">Use</button>
						<button id="drop1_btn" class="action_btn">Drop 1</button>
						<button id="dropstack_btn" class="action_btn">Drop Stack</button>
					</div>
				</div>

			</div>
		</div>
	</body>
</rml>
